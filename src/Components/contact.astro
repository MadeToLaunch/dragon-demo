---
import { site } from "../data/site.js";
---

<section class="contact" id="contact">

  <div class="contact-inner">

    <!-- CONTACT INFORMATION -->
    <div class="contact-info">

      <p class="eyebrow">
        {site.contactSection.eyebrow}
      </p>

      <h2>
        {site.contactSection.heading}
      </h2>

      <p class="intro">
        {site.contactSection.description}
      </p>

      <div class="contact-details">

        <div>
          <span>PHONE</span>

          <a href={`tel:${site.phoneLink}`}>
            {site.phoneDisplay}
          </a>
        </div>


        <div>
          <span>EMAIL</span>

          <a href={`mailto:${site.email}`}>
            {site.email}
          </a>
        </div>


        <div>
          <span>AREA</span>

          <p>
            {site.location}
          </p>
        </div>

      </div>

    </div>


    <!-- QUOTE FORM -->
    <form
      class="quote-form"
      id="quote-form"
      action={site.quoteForm.endpoint}
      method="POST"
    >

      <input
        type="hidden"
        name="business"
        value={site.businessName}
      />


      <div class="field-row">

        <div class="field">

          <label for="name">
            Your name
          </label>

          <input
            id="name"
            name="name"
            type="text"
            placeholder="John Smith"
            required
          />

        </div>


        <div class="field">

          <label for="phone">
            Phone number
          </label>

          <input
            id="phone"
            name="phone"
            type="tel"
            placeholder="07..."
            required
          />

        </div>

      </div>


      <div class="field">

        <label for="email">
          Email address
        </label>

        <input
          id="email"
          name="email"
          type="email"
          placeholder="you@example.com"
          required
        />

      </div>


      <div class="field">

        <label for="service">
          What do you need help with?
        </label>

        <select
          id="service"
          name="service"
          required
        >

          <option value="">
            Select a service
          </option>

          {site.services.map((service) => (
            <option value={service.title}>
              {service.title}
            </option>
          ))}

          <option value="Other">
            Other
          </option>

        </select>

      </div>


      <div class="field">

        <label for="message">
          Tell us about the job
        </label>

        <textarea
          id="message"
          name="message"
          rows="6"
          placeholder="Tell us a little about what you need..."
          required
        ></textarea>

      </div>


      <button
        type="submit"
        id="submit-button"
        data-default-label={site.contactSection.buttonText}
      >
        {site.contactSection.buttonText}
      </button>


      <p class="form-note">
        {site.contactSection.formNote}
      </p>


      <p
        class="form-message"
        id="form-message"
        aria-live="polite"
      ></p>

    </form>

  </div>

</section>


<script is:inline>
  function setupQuoteForm() {

    const form = document.getElementById("quote-form");
    const message = document.getElementById("form-message");
    const button = document.getElementById("submit-button");

    if (!form || !message || !button) {
      return;
    }

    if (form.dataset.connected === "true") {
      return;
    }

    form.dataset.connected = "true";


    form.addEventListener("submit", async function (event) {

      event.preventDefault();


      const endpoint = form.getAttribute("action");

      const defaultLabel =
        button.dataset.defaultLabel ||
        "Request My Free Quote →";


      if (
        !endpoint ||
        endpoint.includes("PASTE FORMSPREE")
      ) {

        message.textContent =
          "This quote form has not been connected yet.";

        message.className =
          "form-message error";

        return;
      }


      button.disabled = true;
      button.textContent = "Sending...";

      message.textContent = "";
      message.className = "form-message";


      try {

        const response = await fetch(endpoint, {

          method: "POST",

          body: new FormData(form),

          headers: {
            Accept: "application/json"
          }

        });


        if (response.ok) {

          form.reset();

          message.textContent =
            "✓ Thanks! Your enquiry has been sent. We'll be in touch shortly.";

          message.className =
            "form-message success";

        } else {

          message.textContent =
            "Something went wrong. Please try again or contact us directly.";

          message.className =
            "form-message error";

        }

      } catch (error) {

        console.error("Quote form error:", error);

        message.textContent =
          "Something went wrong. Please try again or contact us directly.";

        message.className =
          "form-message error";

      }


      button.disabled = false;
      button.textContent = defaultLabel;

    });

  }


  if (document.readyState === "loading") {

    document.addEventListener(
      "DOMContentLoaded",
      setupQuoteForm
    );

  } else {

    setupQuoteForm();

  }


  document.addEventListener(
    "astro:page-load",
    setupQuoteForm
  );
</script>


<style>

  .contact {
    padding: 110px 40px;
    background: #111827;
    color: white;
  }


  .contact-inner {
    max-width: 1200px;
    margin: auto;

    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 80px;
  }


  .eyebrow {
    color: var(--brand);

    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;

    margin-bottom: 16px;
  }


  h2 {
    font-size: 48px;
    line-height: 1.08;
    letter-spacing: -1.5px;

    margin: 0 0 22px;
  }


  .intro {
    color: #cbd5e1;

    font-size: 18px;
    line-height: 1.7;

    max-width: 520px;
  }


  .contact-details {
    margin-top: 45px;

    display: flex;
    flex-direction: column;
    gap: 26px;
  }


  .contact-details div {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }


  .contact-details span {
    color: var(--brand);

    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }


  .contact-details a,
  .contact-details p {
    color: white;

    text-decoration: none;

    margin: 0;

    font-size: 17px;
  }


  .contact-details a:hover {
    color: var(--brand);
  }


  .quote-form {
    padding: 38px;

    background: white;
    border-radius: 18px;

    color: #111827;
  }


  .field-row {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 18px;
  }


  .field {
    display: flex;
    flex-direction: column;

    margin-bottom: 20px;
  }


  label {
    font-size: 14px;
    font-weight: 700;

    margin-bottom: 8px;
  }


  input,
  select,
  textarea {
    width: 100%;

    padding: 14px 15px;

    border: 1px solid #d1d5db;
    border-radius: 9px;

    background: #fafaf8;

    font: inherit;
    color: #111827;
  }


  input:focus,
  select:focus,
  textarea:focus {
    outline: none;

    border-color: var(--brand);
  }


  textarea {
    resize: vertical;
  }


  button {
    width: 100%;

    padding: 16px 24px;

    border: none;
    border-radius: 10px;

    background: var(--brand);
    color: white;

    font-size: 16px;
    font-weight: 800;

    cursor: pointer;

    transition:
      background 0.2s ease,
      opacity 0.2s ease;
  }


  button:hover {
    background: var(--brand-hover);
  }


  button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }


  .form-note {
    text-align: center;

    color: #6b7280;

    font-size: 13px;

    margin: 14px 0 0;
  }


  .form-message {
    text-align: center;

    margin: 14px 0 0;

    font-size: 14px;
    font-weight: 700;

    min-height: 20px;
  }


  .form-message.success {
    color: var(--brand);
  }


  .form-message.error {
    color: #dc2626;
  }



  @media (max-width: 850px) {

    .contact {
      padding: 80px 24px;
    }


    .contact-inner {
      grid-template-columns: 1fr;

      gap: 50px;
    }


    h2 {
      font-size: 38px;
    }

  }



  @media (max-width: 850px) {

  .contact {
    padding: 80px 24px;
  }

  .contact-inner {
    grid-template-columns: 1fr;
    gap: 50px;
  }

  h2 {
    font-size: 38px;
    line-height: 1.05;
  }

  .intro {
    font-size: 16px;
    line-height: 1.7;
  }

  .contact-details {
    margin-top: 35px;
    gap: 22px;
  }

  .quote-form {
    width: 100%;
  }

}


@media (max-width: 600px) {

  .contact {
    padding: 70px 18px;
  }

  .field-row {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .quote-form {
    padding: 26px 20px;
    border-radius: 14px;
  }

  input,
  select,
  textarea {
    font-size: 16px;
  }

  button {
    padding: 15px 18px;
  }

  .form-note,
  .form-message {
    line-height: 1.5;
  }

}
</style>