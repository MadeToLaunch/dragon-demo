---
const { site } = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="footer">

  <div class="footer-inner">

    <div class="footer-brand">

      <a href="/" class="footer-logo">
        <span class="logo-mark">▲</span>
        {site.shortName}
      </a>

      <p>
        {site.footer.description}
      </p>

      <div class="social-links">

        {site.socialLinks.facebook && (
          <a
            href={site.socialLinks.facebook}
            target="_blank"
            rel="noopener noreferrer"
          >
            Facebook
          </a>
        )}

        {site.socialLinks.instagram && (
          <a
            href={site.socialLinks.instagram}
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram
          </a>
        )}

        {site.socialLinks.linkedin && (
          <a
            href={site.socialLinks.linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>
        )}

      </div>

    </div>


    <div class="footer-links">

      <div class="footer-column">

        <h3>Explore</h3>

        <a href="/#services">Services</a>
        <a href="/#about">About</a>
        <a href="/#projects">Our Work</a>
        <a href="/#reviews">Reviews</a>
        <a href="/#areas">Areas</a>

      </div>


      <div class="footer-column">

        <h3>Service Areas</h3>

        {site.areas.slice(0, 4).map((area) => (
          <a href="/#areas">
            {area}
          </a>
        ))}

      </div>


      <div class="footer-column">

        <h3>Contact</h3>

        <a href={`tel:${site.phoneLink}`}>
          {site.phoneDisplay}
        </a>

        <a href={`mailto:${site.email}`}>
          {site.email}
        </a>

        <a href="/#contact">
          Get a Free Quote
        </a>

      </div>

    </div>

  </div>


  <div class="footer-bottom">

    <div class="footer-bottom-inner">

      <p>
        © {currentYear} {site.businessName}. All rights reserved.
      </p>

      <div class="legal-links">

        <a href="/privacy">
          {site.footer.privacyText}
        </a>

        <a href="/terms">
          {site.footer.termsText}
        </a>

      </div>

    </div>

  </div>

</footer>


<style>

  .footer {
    background: #0b1120;
    color: white;
  }

  .footer-inner {
    max-width: 1200px;
    margin: auto;
    padding: 75px 40px;

    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: 80px;
  }

  .footer-brand {
    max-width: 340px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;

    color: white;
    text-decoration: none;

    font-size: 20px;
    font-weight: 800;
  }

  .logo-mark {
    color: var(--brand);
    font-size: 22px;
  }

  .footer-brand p {
    margin-top: 20px;

    color: #94a3b8;

    line-height: 1.7;
    font-size: 15px;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;

    margin-top: 24px;
  }

  .social-links a {
    color: #94a3b8;

    text-decoration: none;

    font-size: 14px;
    font-weight: 700;
  }

  .social-links a:hover {
    color: var(--brand);
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-column h3 {
    margin: 0 0 8px;

    color: white;

    font-size: 14px;
  }

  .footer-column a {
    color: #94a3b8;

    text-decoration: none;

    font-size: 14px;
  }

  .footer-column a:hover {
    color: var(--brand);
  }

  .footer-bottom {
    border-top: 1px solid #1f2937;
  }

  .footer-bottom-inner {
    max-width: 1200px;
    margin: auto;

    padding: 24px 40px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .footer-bottom p {
    margin: 0;

    color: #64748b;

    font-size: 13px;
  }

  .legal-links {
    display: flex;
    gap: 24px;
  }

  .legal-links a {
    color: #64748b;

    text-decoration: none;

    font-size: 13px;
  }

  .legal-links a:hover {
    color: var(--brand);
  }


  @media (max-width: 850px) {

    .footer-inner {
      grid-template-columns: 1fr;

      gap: 50px;

      padding: 65px 24px;
    }

    .footer-brand {
      max-width: none;
    }

    .footer-links {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }

    .footer-bottom-inner {
      padding: 22px 24px;

      flex-direction: column;
      align-items: flex-start;

      gap: 16px;
    }

    .legal-links {
      flex-wrap: wrap;
      gap: 16px;
    }

  }


  @media (max-width: 550px) {

    .footer-inner {
      padding: 55px 18px;
    }

    .footer-links {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .footer-bottom-inner {
      padding: 20px 18px;
    }

    .footer-logo {
      font-size: 18px;
    }

  }

</style>