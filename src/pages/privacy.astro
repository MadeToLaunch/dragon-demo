---
import { site } from "../data/site.js";
import "../styles/global.css";

const currentYear = new Date().getFullYear();

const privacyIntro =
  `This privacy policy explains how ${site.businessName} collects, uses and protects personal information when you use this website or contact us.`;

const pageTitle =
  `Privacy Policy | ${site.businessName}`;

const pageDescription =
  `Privacy Policy for ${site.businessName}.`;

const copyrightText =
  `© ${currentYear} ${site.businessName}. All rights reserved.`;
---

<html
  lang="en"
  style={`--brand: ${site.primaryColour}; --brand-hover: ${site.primaryHover};`}
>

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{pageTitle}</title>

    <meta
      name="description"
      content={pageDescription}
    />

  </head>


  <body>

    <header class="legal-header">

      <div class="legal-nav">

        <a href="/" class="logo">
          <span class="logo-mark">▲</span>
          <span>{site.shortName}</span>
        </a>

        <a href="/" class="back-link">
          ← Back to website
        </a>

      </div>

    </header>


    <main class="legal-page">

      <p class="eyebrow">
        LEGAL
      </p>

      <h1>
        Privacy Policy
      </h1>

      <p class="updated">
        Last updated: October 2026
      </p>


      <!-- ABOUT -->

      <section>

        <h2>
          1. About this policy
        </h2>

        <p>
          {privacyIntro}
        </p>

      </section>


      <!-- INFORMATION COLLECTED -->

      <section>

        <h2>
          2. Information we may collect
        </h2>

        <p>
          When you contact us or request a quotation, we may
          collect information such as:
        </p>

        <ul>
          <li>Your name</li>
          <li>Your telephone number</li>
          <li>Your email address</li>
          <li>The service you are interested in</li>
          <li>Details you provide about your enquiry or project</li>
        </ul>

      </section>


      <!-- HOW INFORMATION IS USED -->

      <section>

        <h2>
          3. How we use your information
        </h2>

        <p>
          We may use the information you provide to:
        </p>

        <ul>
          <li>Respond to your enquiry</li>
          <li>Provide quotations or information about our services</li>
          <li>Arrange or provide services you request</li>
          <li>Communicate with you about your enquiry</li>
          <li>Meet legal or regulatory obligations where applicable</li>
        </ul>

      </section>


      <!-- FORM SUBMISSIONS -->

      <section>

        <h2>
          4. Quote form submissions
        </h2>

        <p>
          Our website may use a third-party form processing
          service to securely process enquiries submitted through
          the website.
        </p>

        <p>
          Information submitted through the quote form may
          therefore be processed by that service on our behalf.
        </p>

      </section>


      <!-- SHARING INFORMATION -->

      <section>

        <h2>
          5. Sharing your information
        </h2>

        <p>
          We do not sell your personal information.
        </p>

        <p>
          We may share information with service providers where
          necessary to operate our website, respond to enquiries,
          provide our services or meet legal obligations.
        </p>

      </section>


      <!-- DATA RETENTION -->

      <section>

        <h2>
          6. How long we keep information
        </h2>

        <p>
          We only keep personal information for as long as
          reasonably necessary for the purpose it was collected
          for, including any legal, accounting or reporting
          requirements.
        </p>

      </section>


      <!-- RIGHTS -->

      <section>

        <h2>
          7. Your rights
        </h2>

        <p>
          Depending on applicable data protection law, you may
          have rights relating to your personal information,
          including requesting access, correction or deletion of
          your information.
        </p>

        <p>
          To make a request, contact us using the details below.
        </p>

      </section>


      <!-- COOKIES -->

      <section>

        <h2>
          8. Cookies
        </h2>

        <p>
          This website may use essential cookies or similar
          technologies required for the website to operate.
        </p>

        <p>
          If additional analytics, advertising or tracking tools
          are added to the website, this policy and any cookie
          notice should be updated accordingly.
        </p>

      </section>


      <!-- CONTACT -->

      <section>

        <h2>
          9. Contact us
        </h2>

        <p>
          If you have any questions about this privacy policy or
          how your information is handled, contact:
        </p>

        <div class="contact-card">

          <strong>
            {site.businessName}
          </strong>

          <span>
            {site.location}
          </span>

          <a href={`mailto:${site.email}`}>
            {site.email}
          </a>

          <a href={`tel:${site.phoneLink}`}>
            {site.phoneDisplay}
          </a>

        </div>

      </section>

    </main>


    <footer class="legal-footer">

      <p>
        {copyrightText}
      </p>

    </footer>

  </body>

</html>


<style>

  .legal-header {
    background: white;
    border-bottom: 1px solid #e5e7eb;
  }


  .legal-nav {
    max-width: 1000px;
    margin: auto;
    padding: 22px 30px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    gap: 20px;
  }


  .logo {
    display: flex;
    align-items: center;
    gap: 9px;

    text-decoration: none;
    color: #111827;

    font-size: 18px;
    font-weight: 800;
  }


  .logo-mark {
    color: var(--brand);
  }


  .back-link {
    color: #6b7280;
    text-decoration: none;

    font-weight: 700;
    font-size: 14px;
  }


  .back-link:hover {
    color: var(--brand);
  }


  .legal-page {
    max-width: 850px;
    margin: auto;

    padding: 90px 30px;
  }


  .eyebrow {
    color: var(--brand);

    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;

    margin: 0;
  }


  h1 {
    margin: 14px 0;

    color: #111827;

    font-size: clamp(44px, 7vw, 72px);
    line-height: 1;
    letter-spacing: -3px;
  }


  .updated {
    color: #6b7280;

    margin: 0 0 60px;
  }


  section {
    margin-bottom: 44px;
  }


  h2 {
    color: #111827;

    font-size: 24px;

    margin: 0 0 14px;
  }


  p,
  li {
    color: #4b5563;

    line-height: 1.8;
    font-size: 16px;
  }


  ul {
    padding-left: 24px;
  }


  a {
    color: var(--brand);
  }


  .contact-card {
    margin-top: 20px;

    padding: 24px;

    background: #fafaf8;
    border: 1px solid #e5e7eb;
    border-radius: 12px;

    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 7px;
  }


  .contact-card strong {
    color: #111827;

    font-size: 17px;
  }


  .contact-card span {
    color: #4b5563;
  }


  .contact-card a {
    text-decoration: none;
  }


  .contact-card a:hover {
    text-decoration: underline;
  }


  .legal-footer {
    border-top: 1px solid #e5e7eb;

    padding: 30px;

    text-align: center;
  }


  .legal-footer p {
    margin: 0;

    color: #6b7280;

    font-size: 14px;
  }


  @media (max-width: 600px) {

    .legal-page {
      padding: 65px 24px;
    }


    .legal-nav {
      padding: 18px 24px;
    }


    .back-link {
      font-size: 13px;
    }


    h1 {
      letter-spacing: -2px;
    }

  }

</style>