---
import { site } from "../data/site.js";
import "../styles/global.css";

const pageTitle =
  `Page Not Found | ${site.businessName}`;
---

<html
  lang="en"
  style={`--brand: ${site.primaryColour}; --brand-hover: ${site.primaryHover};`}
>

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{pageTitle}</title>

    <meta
      name="robots"
      content="noindex"
    />

  </head>


  <body>

    <main class="error-page">

      <div class="error-card">

        <a href="/" class="logo">
          <span class="logo-mark">▲</span>
          <span>{site.shortName}</span>
        </a>

        <p class="eyebrow">
          ERROR 404
        </p>

        <h1>
          Page not found.
        </h1>

        <p class="description">
          The page you're looking for doesn't exist or may have moved.
        </p>

        <div class="buttons">

          <a href="/" class="primary">
            Back to Homepage
          </a>

          <a href="/#contact" class="secondary">
            Contact Us
          </a>

        </div>

      </div>

    </main>

  </body>

</html>


<style>

  .error-page {
    min-height: 100vh;

    padding: 40px 24px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #fafaf8;
  }


  .error-card {
    width: 100%;
    max-width: 760px;

    text-align: center;
  }


  .logo {
    display: inline-flex;
    align-items: center;

    gap: 10px;

    margin-bottom: 60px;

    color: #111827;

    text-decoration: none;

    font-size: 19px;
    font-weight: 800;
  }


  .logo-mark {
    color: var(--brand);

    font-size: 22px;
  }


  .eyebrow {
    margin: 0 0 18px;

    color: var(--brand);

    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
  }


  h1 {
    margin: 0;

    color: #111827;

    font-size: clamp(52px, 9vw, 90px);

    line-height: 0.95;

    letter-spacing: -4px;
  }


  .description {
    max-width: 560px;

    margin: 28px auto 0;

    color: #6b7280;

    font-size: 19px;
    line-height: 1.7;
  }


  .buttons {
    margin-top: 36px;

    display: flex;
    justify-content: center;

    gap: 14px;
  }


  .buttons a {
    padding: 15px 24px;

    border-radius: 10px;

    text-decoration: none;

    font-weight: 800;
  }


  .primary {
    background: var(--brand);

    color: #ffffff;
  }


  .primary:hover {
    background: var(--brand-hover);
  }


  .secondary {
    background: #ffffff;

    color: #111827;

    border: 1px solid #d1d5db;
  }


  .secondary:hover {
    border-color: var(--brand);

    color: var(--brand);
  }


  @media (max-width: 600px) {

    .error-page {
      padding: 30px 18px;
    }


    .logo {
      margin-bottom: 45px;

      font-size: 17px;
    }


    h1 {
      font-size: 52px;

      letter-spacing: -2.5px;
    }


    .description {
      font-size: 17px;
    }


    .buttons {
      flex-direction: column;
    }


    .buttons a {
      width: 100%;

      text-align: center;
    }

  }

</style>